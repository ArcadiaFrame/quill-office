.docker-cache/
build_output.log

# ── Build outputs (never commit) ────────────────────────────────────────────
# The Windows build (build/windows/build.ps1) runs CMake in the repo root, so its
# outputs land here. Keep this list in step with .dockerignore.

# Common editors payload and the installed app tree
/common/
/desktopeditors/

# CMake / Ninja / Qt / vcpkg
/.ninja_deps
/.ninja_log
/.qt/
/.vcpkg/
/build.ninja
/cmake_install.cmake
/CMakeCache.txt
/CMakeFiles/
/install_manifest.txt
/vcpkg_installed/
/vcpkg-manifest-install.log
/third_party/
/*_autogen/
/qrc_*.cpp
/app_icon.rc
/*.exe

# Per-component build directories (core, x2t, format libraries)
/allfontsgen/
/allthemesgen/
/ascdocumentscore/
/DjVuFile/
/EpubFile/
/Fb2File/
/HWPFile/
/IWorkFile/
/OFDFile/
/PdfFile/
/XpsFile/
/hunspell-wrapper/
/ooxmlsignature/
/qtascdocumentscore/
/x2t/
/package/

# Build logs
/*.log

# Packaging outputs (Windows installer/zip staging, Linux packages, docker caches)
/desktop-apps/package/build/
/desktop-apps/package/zip/
/desktop-apps/package/inno/*.exe
/build/deploy/
/build/linux/deploy/
/build/windows/.docker-cache/

# Generated by the Quill Office scripts (rebuilt on demand)
__pycache__/
/aero/templates/out/_preview*
